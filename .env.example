# PrefectOS environment — copy to /etc/prefectos.env (chmod 600, root-owned)
# and reference from systemd:  EnvironmentFile=/etc/prefectos.env
# NEVER commit the real file. The pre-commit scan blocks live keys.

# ── AI provider: "anthropic" (normal Claude API keys, DEFAULT) ──────────
PREFECTOS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME          # console.anthropic.com -> API keys
INGEST_EXCEPTION_MODEL=claude-haiku-4-5-20251001
ROUTE_RESOLVER_MODEL=claude-haiku-4-5-20251001
ROUTE_SUPERVISOR_MODEL=claude-sonnet-4-6           # ephemeral agents (planner etc.)

# ── Workers ─────────────────────────────────────────────────────────────
INGEST_WORKERS=4                                   # = vCPUs on this box
INGEST_SLA_SECONDS=10
BATCH_TOKEN_BUDGET=500000
POOL_MAX_CONCURRENCY=8

# ── Later: flip to Bedrock (no key needed on AWS; IAM key pair on E2E/GCP)
# PREFECTOS_LLM_PROVIDER=bedrock
# AWS_REGION=ap-south-1
# INGEST_EXCEPTION_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# ROUTE_RESOLVER_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# ── Later: LiteLLM proxy / Groq via proxy ──────────────────────────────
# INGEST_LLM_BASE_URL=http://127.0.0.1:4000
# ROUTE_RESOLVER_BASE_URL=http://127.0.0.1:4000
