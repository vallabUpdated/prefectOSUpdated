# ── PrefectOS .gitignore ─────────────────────────────────────────
# Secrets — never in git, ever
.env
.env.*
!.env.example
*.pem
*.key
/etc/prefectos.env

# Runtime data & evidence (lives in ~/prefectos/data, symlinked in)
projects/
project_output/
loadtest_docs/
memory/
*.jsonl
!**/fixtures/**/*.jsonl

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / frontend build
node_modules/
dist/
ui/dist/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Demo kit run artifacts — the folder is kept, its contents are not
demo_kit/loan_kit/output/*
!demo_kit/loan_kit/output/.gitkeep

# Bank-roles e2e run artifacts (screenshots, report, video) — regenerated by e2e_test_bank_roles.py
e2e_artifacts_roles/

# Local scratch
*.zip

# Server runtime logs (server.py / batch_api.py stdout+stderr)
*.out.log
*.err.log
sqs_test_docs/
regress/
samples/email_packs.zip
